# Copy this file to secrets.properties and fill in your values.
# secrets.properties is git-ignored — never commit real credentials.

# Supabase project settings (Project Settings → API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Google OAuth Web Client ID (from Google Cloud Console → Credentials)
# This is the Web client ID, not the Android client ID.
GOOGLE_WEB_CLIENT_ID=your-client-id.apps.googleusercontent.com
